#!/usr/bin/env sh
set -eu

# PanganKita mojibake guard
repo_root="$(git rev-parse --show-toplevel)"

if command -v python3 >/dev/null 2>&1; then
  python_cmd="python3"
elif command -v python >/dev/null 2>&1; then
  python_cmd="python"
else
  echo "Python is required for the mojibake pre-commit check." >&2
  exit 1
fi

echo "Checking UTF-8 and mojibake..."
"$python_cmd" "$repo_root/.github/scripts/check_mojibake.py"

echo "Checking staged trailing whitespace..."
"$python_cmd" "$repo_root/.github/scripts/check_trailing_whitespace.py" --fix-staged
echo "Running PanganKita pre-commit checks..."

staged_dart_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')

if [ -n "$staged_dart_files" ]; then
  echo "Formatting staged Dart files..."

  echo "$staged_dart_files" | while IFS= read -r file; do
    [ -f "$file" ] || continue
    dart format "$file"
    git add -- "$file"
  done
fi

echo "Pre-commit formatting complete."
