# ============================================================
# PanganKita — Repository-wide ignores
# ============================================================

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor
.idea/
**/.idea/
*.iml
*.ipr
*.iws

# VS Code
# Keep this ignored unless we later decide to commit shared workspace settings.
.vscode/

# Logs / temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
.tmp/

# Environment / local configuration
.env
.env.*
!.env.example
!.env.*.example

# Credentials / signing material
*.jks
*.keystore
key.properties
**/local.properties

# Flutter / Dart generated files
**/.dart_tool/
**/.pub/
**/.pub-cache/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/coverage/
**/doc/api/
**/*.symbols
**/*.map.json
**/.widget_preview/

# Node.js — future backend/tooling
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python — future research/tooling
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Test / tool output
**/test-results/
**/.coverage
